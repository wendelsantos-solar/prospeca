{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/set-org-quota.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/router.tsx",
        "src/routeTree.gen.ts",
        "src/routes/**/*.tsx",
        "e2e/**/*.e2e.ts",
        "playwright.config.ts",
        "vite.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts"]
    },
    "packages/domain": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/geo": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignore": ["supabase/**", ".lovable/**", ".turbo/**"]
}
