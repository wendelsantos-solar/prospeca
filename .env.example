# ── Frontend (bundled — public values only, never secrets) ──────────
# NOTE (monorepo): env files live at the REPO ROOT; apps/web reads them via
# vite `envDir`. Do not move them into apps/web.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Browser key: restrict by domain; enable only Maps JavaScript API.
# Optional — leave empty to use the OSM/Leaflet map (see MAP_* below).
VITE_GOOGLE_MAPS_BROWSER_KEY=
# Google OAuth client ID (browser-side). Optional — Google sign-in is hidden
# when unset (see isGoogleAuthConfigured() in hooks/useAuth.ts).
VITE_GOOGLE_CLIENT_ID=
# Data mode: "real" (Supabase) or "demo" (local mock data).
# In production this MUST be "real". Missing real config => config error
# screen, never a silent mock fallback.
VITE_DATA_MODE=demo

# ── Map ─────────────────────────────────────────────────────────────
# With VITE_GOOGLE_MAPS_BROWSER_KEY set, the app renders Google Maps. Without
# it, it falls back to Leaflet with these OSM tiles (attribution MANDATORY).
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors

# ── Edge Functions (Supabase secrets — set via `supabase secrets set`) ─
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=
APP_ENV=development

# Google (REQUIRED — sole discovery/geocoding provider; billing must be on).
# Restrict the key by API + edge IP. If it fails, search stops (no fallback).
GOOGLE_MAPS_SERVER_KEY=

# Google Calendar + Meet — OAuth web application credentials. The redirect URI
# must exactly match the URI registered in Google Cloud. If omitted, the Edge
# Function uses: SUPABASE_URL/functions/v1/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
# 32 random bytes encoded as base64, e.g. `openssl rand -base64 32`.
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Anthropic API key — used by generate-contact-message (roadmap 3.5, AI
# first-contact opener). Model: claude-haiku-4-5-20251001. Feature degrades
# to "generation_failed" (frontend falls back to the template) if absent.
ANTHROPIC_API_KEY=

# Max results persisted per search. Google Text Search bills per page
# (pageSize 20, cap 60 = 3 pages).
SEARCH_MAX_RESULTS=60

# ── Observability ───────────────────────────────────────────────────
# Sentry DSN for error tracking (frontend + edge functions).
# Without it, errors are persisted to error_events and aggregated by error-digest cron.
# With it, errors also appear in real-time in the Sentry dashboard.
# See docs/OBSERVABILITY.md and docs/SENTRY_SETUP.md for setup.
SENTRY_DSN=
VITE_SENTRY_DSN=
# Public app version (displayed in feedback form, error reports)
VITE_APP_VERSION=

# ── E-mail (transactional) ──────────────────────────────────────────
# Resend — used by _shared/email.ts for invitations, password resets, etc.
RESEND_API_KEY=
SMTP_FROM="Prospeca <suporte@prospeca.com.br>"
# Inbox that receives "Falar com a gente" submissions (submit-sales-contact).
# Required until real checkout exists — this IS the manual payment funnel.
# Without it, submissions are only visible via SQL on the sales_contacts table.
SALES_NOTIFY_EMAIL=
# Inbox that receives the error digest and new customer feedback. Without it,
# errors and feedback remain stored but do not proactively alert the team.
ADMIN_ALERT_EMAIL=

# ── Billing (Stripe) ───────────────────────────────────────────────
# Without STRIPE_SECRET_KEY, billing endpoints return BILLING_NOT_CONFIGURED.
# All billing code is already integrated — just add the keys.
# See docs/EXTERNAL_CONFIGURATION_CHECKLIST.md for setup steps.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Frontend publishable key (safe to expose).
VITE_STRIPE_PUBLISHABLE_KEY=
# Stripe price IDs (set AFTER creating products in Stripe dashboard).
# These are inserted into billing_plans.provider_monthly_price_id / provider_annual_price_id.
# STRIPE_PRICE_SOLO_MONTHLY=
# STRIPE_PRICE_SOLO_ANNUAL=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_AGENCY_MONTHLY=
# STRIPE_PRICE_AGENCY_ANNUAL=

# ── Rate limiting ───────────────────────────────────────────────────
# Set to "true" for fail-open (dev/beta: allow requests when counter is down).
# In production, leave unset (defaults to fail-closed: block if counter unavailable).
RATE_LIMIT_FAIL_OPEN=

# ── Feature flags (build-time, requires redeploy to change) ──────────
# Set to "true" to enable features that depend on external config.
# VITE_AI_ENABLED=true

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated origins allowed for CORS (default APP_URL + localhost)
CORS_ORIGINS=
