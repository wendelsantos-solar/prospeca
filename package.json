{
  "name": "leads-platform",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@leads/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "org:set-quota": "deno run -A --env-file=.env.local scripts/set-org-quota.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "bun-types": "^1.3.14",
    "eslint": "^9.32.0",
    "prettier": "^3.7.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "turbo": "^2.10.5",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "web-vitals": "^6.0.1"
  }
}
