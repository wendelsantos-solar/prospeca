{
  "name": "leads-platform",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@leads/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:pilot": "bun run lint && bun run typecheck && bun run format:check && REQUIRE_RLS_DB=true bun test && bun run build && deno lint supabase/functions/ && deno check supabase/functions/*/index.ts && bun run test:e2e",
    "org:set-quota": "deno run -A --env-file=.env.local scripts/set-org-quota.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "bun-types": "^1.3.14",
    "eslint": "^9.39.5",
    "prettier": "3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "turbo": "^2.10.9",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "web-vitals": "^6.0.1"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "brace-expansion": "5.0.9",
    "esbuild": "0.28.1",
    "js-yaml": "4.3.0",
    "postcss": "8.5.25"
  }
}
